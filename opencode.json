{
  "$schema": "https://opencode.ai/config.json",
  "username": "Yaqub",
  "model": "anthropic/claude-sonnet-4-6",
  "default_agent": "system-agent",
  "agent": {
    "system-agent": {
      "description": "AI agent with full system access for software engineering tasks",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": "allow",
        "external_directory": "allow"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "external_directory": "allow"
  },
  "mcp": {
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    },
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ctx7sk-5a7cade3-76f7-40d5-9dea-222bcd6bf631"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "firefox"
      ],
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    },
    "firefox": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "gecko-mcp"
      ],
      "environment": {
        "GECKO_MCP_BACKEND": "marionette"
      },
      "enabled": true
    },
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "21st_sk_bbe24e329c8b43851f2a171995eaf4be6c40a6833e8fd1af47b49d4f64ef8745"
      }
    }
  }
}
