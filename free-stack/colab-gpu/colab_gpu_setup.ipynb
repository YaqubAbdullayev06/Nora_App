# Vision models
!ollama pull llava:7b

# Embedding models
!ollama pull nomic-embed-text

print("\n✅ Models pulled successfully!")

# ============================================================
# CELL 5: Test the setup
# ============================================================
import requests

OLLAMA_URL = public_url

# Test chat
response = requests.post(
    f"{OLLAMA_URL}/api/chat",
    json={
        "model": "llama3.1:8b",
        "messages": [{"role": "user", "content": "Hello! What model are you?"}],
        "stream": False,
    },
)

print("=== Chat Test ===")
print(response.json()["message"]["content"])

# Test embeddings
response = requests.post(
    f"{OLLAMA_URL}/api/embeddings",
    json={
        "model": "nomic-embed-text",
        "prompt": "Hello world",
    },
)

print(f"\n=== Embedding Test ===")
print(f"Dimensions: {len(response.json()['embedding'])}")

# ============================================================
# CELL 6: Keep alive / status check
# ============================================================
print("\n" + "=" * 50)
print("🎉 GPU Ollama is ready!")
print("=" * 50)
print(f"\n📡 API URL: {OLLAMA_URL}")
