# ============================================================
# CELL 1: Install Ollama
# ============================================================
!curl -fsSL https://ollama.com/install.sh | sh

# ============================================================
# CELL 2: Start Ollama server in background
# ============================================================
import subprocess
import time

# Start Ollama serve in background
subprocess.Popen(
    ["ollama", "serve"],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)

time.sleep(5)  # Wait for server to start
print("✅ Ollama server started")

# ============================================================
# CELL 3: Install ngrok and expose Ollama
# ============================================================
!pip install pyngrok -q

from pyngrok import ngrok

# Free ngrok authtoken (optional but recommended for stability)
# Sign up at: https://dashboard.ngrok.com/signup
# Uncomment and paste your token:
# ngrok.set_auth_token("your_token_here")

# Expose Ollama on port 11434
public_url = ngrok.connect(11434)
print(f"\n🌐 Your Ollama API endpoint:")
print(f"   {public_url}")
print(f"\n📋 Use this URL in your app:")
print(f'   OLLAMA_BASE_URL="{public_url}"')

# ============================================================
# CELL 4: Pull and run models
# ============================================================

