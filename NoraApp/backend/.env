# ─── Database ───
# MariaDB / MySQL connection
DATABASE_URL=mysql+pymysql://root:1@localhost:3306/nora_db

# ─── JWT ───
# JWT secret (change in production)
SECRET_KEY=nora-secret-key-change-in-production

# ─── LLM Provider (Free Stack) ───
# Provider: auto | groq | ollama | ollama_colab
# auto = try Groq first → Ollama local → Ollama Colab
LLM_PROVIDER=auto

# Groq (fast, free tier — no credit card)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Ollama local (if running Ollama on this machine)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Colab GPU (paste your ngrok URL from Colab notebook)
# Run colab_gpu_setup.ipynb → copy the ngrok URL here
OLLAMA_COLAB_URL=
