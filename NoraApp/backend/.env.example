# ─── Database ───
# Local: sqlite:///./nora.db
# Production (Render): automatically set by render.yaml
DATABASE_URL=sqlite:///./nora.db

# ─── JWT ───
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# ─── LLM Provider (Free Stack) ───
LLM_PROVIDER=auto

# Groq (fast, free tier — get key at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Gemini (Google AI Studio — get key at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Cloudflare Workers AI (get at dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Ollama local (not available on cloud — leave empty for production)
OLLAMA_BASE_URL=
OLLAMA_COLAB_URL=
